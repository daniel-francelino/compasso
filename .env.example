# Public address of the site (no trailing slash); used for links in emails, canonical URLs and the sitemap
SITE_URL=

# Supabase project URL; public, goes to the browser
VITE_SUPABASE_URL=
# Supabase publishable (anon) key; public, goes to the browser, protected by RLS
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key; SECRET, server only, bypasses RLS (invitations, jobs, audit)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare account id; builds the R2 endpoint when R2_ENDPOINT is empty
R2_ACCOUNT_ID=
# R2 S3 endpoint (https://<account>.r2.cloudflarestorage.com); optional if R2_ACCOUNT_ID is set
R2_ENDPOINT=
# R2 API token access key id; server only
R2_ACCESS_KEY_ID=
# R2 API token secret; SECRET, server only
R2_SECRET_ACCESS_KEY=
# Private bucket with the originals of the media library
R2_BUCKET=
# Public bucket with the web images of the site (optional until the site publishes images)
R2_PUBLIC_BUCKET=
# Custom domain of the public bucket (https://media.example.com); base of the public image URLs
SITE_MEDIA_BASE_URL=

# Resend API key; SECRET, sends the email outbox
RESEND_API_KEY=
# Sender of the emails, e.g. Compasso <no-reply@example.com>; domain verified in Resend
EMAIL_FROM=

# Cloudflare Turnstile site key; public, shows the captcha on the contact form
VITE_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret; SECRET, the contact form refuses submissions without it
TURNSTILE_SECRET=

# Shared secret that authorizes the Vercel cron routes (/api/cron/*); SECRET
CRON_SECRET=

# Email of the first Owner, used only by the seed script (npm run seed:owner)
OWNER_EMAIL=
# Password of the first Owner, used only by the seed script; SECRET, remove after seeding
OWNER_PASSWORD=
